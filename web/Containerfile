# campus-apply web 容器（Apple container / 任意 OCI 构建器均可）
# 构建上下文是仓库根目录：container build -t campus-apply-web -f web/Containerfile .
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    CAMPUS_INSTANCE=/instance \
    CAMPUS_WEB_HOST=0.0.0.0 \
    CAMPUS_WEB_PORT=8787 \
    TZ=Asia/Shanghai

RUN pip install --no-cache-dir "pyyaml==6.0.2"

WORKDIR /app
COPY web/app/ /app/

EXPOSE 8787
HEALTHCHECK --interval=30s --timeout=3s CMD python -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:8787/healthz',timeout=2)"
CMD ["python", "/app/server.py"]
